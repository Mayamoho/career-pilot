# Copy this file to `.env` in the project directory, then fill in one key.
#
#   Linux/macOS   cp .env.example .env
#   Windows       copy .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored — this file holds a credential that spends your money, so it
# never gets committed and never gets pasted into a terminal screenshot.
#
# A key is needed only for `score-job`, `tailor` and `record-fixtures`. `collect`,
# `jobs` and `traces` run without one.

# Required to make any model call. Get one at console.groq.com (has a free tier).
GROQ_API_KEY=

# Optional. Tried only when Groq fails or is not configured.
GEMINI_API_KEY=

# Real model calls are opt-in and off by default, so that tests and CI can never
# spend money by accident. Without this line the tool replays recorded answers and
# refuses to invent one for a prompt it has never seen.
CAREERPILOT_LIVE=1
